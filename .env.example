NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_CERT_TOKEN_SECRET=replace-this-with-a-secure-32-character-random-secret
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# Server-only Meta WhatsApp Cloud API settings. Leave unset to disable outbound WhatsApp.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TO=
META_WHATSAPP_TEMPLATE_NAME=keetrack_asset_alert
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_GRAPH_API_VERSION=v26.0
# Optional Upstash Redis (Vercel Marketplace): lets Demo Controls save a new Meta token without a redeploy.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Server-only webhook settings. Both values are required to verify callbacks.
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
