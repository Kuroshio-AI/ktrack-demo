{
  "name": "keetrack-demo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:fls": "NEXT_PUBLIC_CLIENT=fls next dev --port 3001",
    "dev:ams": "NEXT_PUBLIC_CLIENT=ams next dev --port 3002",
    "dev:gex": "NEXT_PUBLIC_CLIENT=gex next dev --port 3004",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/*.test.ts",
    "cf:preview": "NEXT_PUBLIC_CLIENT=ams NEXT_PUBLIC_TRIAL=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "ls .env .env.local .env.production .env.production.local 2>/dev/null | grep . && echo \"The Cloudflare build copies these .env files into the worker. Deploy from a checkout without them.\" && exit 1; NEXT_PUBLIC_CLIENT=ams NEXT_PUBLIC_TRIAL=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "@radix-ui/react-slot": "1.2.3",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "motion": "14.2.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "2.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.9.2",
    "wrangler": "4.156.0"
  }
}
