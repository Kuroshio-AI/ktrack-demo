// The Al Mansoori trial on Cloudflare Workers, built by OpenNext (open-next.config.ts). The Vercel demo ignores this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ktrack-ams-trial",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Sign-in and shared records (lib/auth.ts, app/api/sync). Migrations in migrations/.
  "d1_databases": [{ "binding": "DB", "database_name": "ktrack-ams-trial", "database_id": "a6bac757-fd8a-421b-8583-13e06930c7ed" }],
  // BETTER_AUTH_SECRET is a secret (wrangler secret put); local preview reads both from .dev.vars.
  "vars": { "BETTER_AUTH_URL": "https://ktrack-ams-trial.devops-731.workers.dev" }
}
